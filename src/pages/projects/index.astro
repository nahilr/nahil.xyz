---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'projects', text: 'Personal Projects' },
  { depth: 2, slug: 'works', text: 'Works' },
  { depth: 2, slug: 'ctf-participations', text: 'CTF Participations' },
  { depth: 2, slug: 'git-activity', text: 'Git Activity' }
]
---

<PageLayout title='Projects' {headings}>

  <h2 id='projects'>Personal Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'Revx',
        description:
          'A peer-driven platform where students can upload projects, review peer work, and explore a collaborative space for innovation and feedback.',
        links: [
          { type: 'github', href: 'https://github.com/nahilr/RevX' },
          {
            type: 'site',
            href: 'https://revx-7r6.pages.dev/'
          }
        ]
      }
    ]}
  />

  <h2 id='works'>Works</h2>
  <ProjectSection
    projects={[
      {
        name: 'SGOU',
        description: 'State Gazetted Officers Union (SGOU) Website.',
        links: [
          {
            type: 'site',
            href: 'https://sgou.org/'
          }
        ]
      }
    ]}
  />

  <h2 id='ctf-participations'>CTF Participations</h2>
  <ProjectSection
    projects={[
      {
        name: 'ApoorvCTF 26',
        description:
          'Annual CTF organized by the Cybersecurity club at IIIT Kottayam. Placed 47th among 2500+ teams.',
        links: [
          {
            type: 'doc',
            href: '/vault/writeups/apoorvctf2026'
          }
        ]
      }
    ]}
  />

  <h2 id='git-activity'>Git Activity</h2>
  <p>
    <img
      src='https://raw.githubusercontent.com/nahilr/nahilr/main/assets/3d-graph/profile-night-green.svg'
      alt='GitHub contribution profile'
      loading='lazy'
    />
  </p>
</PageLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Track project link clicks
    var projectLinks = document.querySelectorAll(
      'a[href^="https://revx-7r6"], a[href^="https://sgou.org"], a[href^="https://github.com/nahilr/RevX"]'
    )
    projectLinks.forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('project_link_clicked', {
          href: el.getAttribute('href'),
          source: 'projects_page'
        })
      })
    })

    // Track CTF writeup link clicks
    var ctfLinks = document.querySelectorAll('a[href^="/vault/writeups"]')
    ctfLinks.forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('ctf_writeup_link_clicked', {
          href: el.getAttribute('href')
        })
      })
    })
  })
</script>
