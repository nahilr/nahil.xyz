---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/BaseLayout.astro'
import { ImageCard } from '@/components/about'
import PostPreview from '@/components/pages/PostPreview.astro'
import { Icon, Label, Section } from '@/components/user'
import { getEnrichedVaultCollection } from '@/utils/vault'
import config from '@/site-config'

const MAX_ITEMS = 7

// Get unified collection
const allVault = await getEnrichedVaultCollection()

type ContentItem =
  | { type: 'post'; data: (typeof allVault)[number]; date: Date }
  | { type: 'note'; data: (typeof allVault)[number]; date: Date }

// Map all vault entries, sort by date descending and take latest
const latestContent: ContentItem[] = allVault
  .map((entry) => ({
    type: (entry.data.type.includes('post') ? 'post' : 'note') as 'post' | 'note',
    data: entry,
    date: entry.data.publishDate ?? entry.data.updatedDate ?? new Date(0)
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, MAX_ITEMS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Track "Explore the Vault" CTA click
      document.querySelector('a[href="/vault"]')?.addEventListener('click', function () {
        window.posthog?.capture('vault_explore_clicked')
      })

      // Track social link clicks from homepage
      var socialLinks = [
        { selector: 'a[href="https://github.com/nahilr"]', platform: 'github' },
        { selector: 'a[href="https://linkedin.com/in/nahilrasheed"]', platform: 'linkedin' },
        { selector: 'a[href="mailto:hi@nahil.xyz"]', platform: 'email' }
      ]
      socialLinks.forEach(function (item) {
        document.querySelector(item.selector)?.addEventListener('click', function () {
          window.posthog?.capture('social_link_clicked', {
            platform: item.platform,
            source: 'homepage'
          })
        })
      })

      // Track homepage project card clicks
      document.querySelectorAll('a[href^="https://revx-7r6"]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('project_link_clicked', { project: 'RevX', source: 'homepage' })
        })
      })
    })
  </script>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='India'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='Github' as='a' href='https://github.com/nahilr' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Linkedin'
            as='a'
            href='https://linkedin.com/in/nahilrasheed'
            target='_blank'
          >
            <Icon name='linkedin' class='size-5' slot='icon' />
          </Label>
          <Label title='Email' as='a' href='mailto:hi@nahil.xyz' target='_blank'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>
          Hi, I'm Nahil Rasheed.
          <span class='font-mono tracking-tight'> aka <span class='text-primary'>0xnhl</span></span>
        </p>
        <p>
          A Cybersecurity Enthusiast & Developer. This space acts as a personal repository for my
          work in cybersecurity, documenting everything from technical labs and CTF challenges to my
          latest software experiments.
          <a
            href='/about'
            class='group float-right ml-2 inline-flex items-center gap-x-1 text-sm text-muted-foreground transition-colors hover:text-foreground'
          >
            More about me
            <Icon
              name='arrow-right-animated'
              class='size-4 shrink-0 stroke-muted-foreground group-hover:stroke-foreground'
            />
          </a>
        </p>
        <a
          href='/vault'
          class='group flex w-full flex-row items-center gap-x-3 rounded-2xl border bg-background px-4 py-3 text-sm transition-colors ease-in-out hover:bg-muted hover:text-primary'
        >
          <div class='flex flex-col items-start gap-y-1'>
            <p class='font-medium text-muted-foreground transition-colors group-hover:text-primary'>
              🗃️ Explore the Vault
            </p>
            <span class='text-xs text-muted-foreground'>A collection of my notes and writeups</span>
          </div>
          <Icon
            name='arrow-right-animated'
            class='size-4 shrink-0 stroke-muted-foreground transition-colors group-hover:stroke-primary ml-auto'
          />
        </a>
      </Section>

      {
        latestContent.length > 0 && (
          <Section title='Recent'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {latestContent.map((item) =>
                item.type === 'post' ? (
                  <PostPreview post={item.data} withType />
                ) : (
                  <PostPreview
                    withType
                    note={{
                      title: item.data.data.title || item.data.slug,
                      slug: item.data.slug,
                      date: item.date,
                      draft: item.data.data.publish === false,
                      type: item.data.data.type || 'note'
                    }}
                  />
                )
              )}
            </ul>
          </Section>
        )
      }

      <!-- <Section title='Certifications'>
        <div class='flex flex-col gap-3'>
          <ImageCard
            as='a'
            heading='Google Cybersecurity Professional Certificate'
            subheading='Google'
            date='Dec 2025'
            href='https://www.coursera.org/account/accomplishments/specialization/48W6CHQVROD8'
            imagePath='/src/assets/about/gcpc.png'
          />
          <ImageCard
            as='a'
            heading='Cisco Ethical Hacker'
            subheading='Cisco'
            date='July 2025'
            href='https://www.credly.com/badges/f806a313-6c62-4810-b196-eecc93dcb6a8/'
            imagePath='/src/assets/about/cisco-eh.png'
          />
        </div>
      </Section> -->

      <div class='flex justify-center pt-2'>
        <a
          href='https://tryhackme.com/p/0xnhl'
          target='_blank'
          rel='noopener noreferrer'
          class='rounded-2xl transition-transform hover:-translate-y-0.5'
        >
          <img
            src='https://raw.githubusercontent.com/nahilr/nahilr/main/assets/thm_badge.png'
            alt='TryHackMe badge'
            loading='lazy'
            class='rounded-2xl'
          />
        </a>
      </div>
    </div>
  </main>
</PageLayout>
