---
import PageLayout from '@/layouts/SimplePageLayout.astro'
import { Button } from '@/components/user'
import { cn } from '@/utils'
import { getUniqueVaultTagsWithCount } from '@/utils/vault'

const allTags = await getUniqueVaultTagsWithCount()

const meta = {
  description: "A list of all the topics I've written about in my posts and vault notes",
  title: 'Tags'
}
---

<PageLayout {meta} title='Tags' back='/'>
  <div id='content' class='animate'>
    {
      allTags.length > 0 ? (
        <ul class='flex flex-wrap gap-4'>
          {allTags.map(([tag, val]) => (
            <li>
              <Button
                href={`/tags/${tag}`}
                variant='pill'
                class={cn(
                  'items-start gap-x-1',
                  val > 2 ? 'rounded-xl px-3 py-1 text-xl' : val > 1 && 'text-lg'
                )}
              >
                {tag}
                <span class={val > 2 ? 'text-base' : 'text-xs'}>{val}</span>
              </Button>
            </li>
          ))}
        </ul>
      ) : (
        <p>No content yet.</p>
      )
    }
  </div>
</PageLayout>
