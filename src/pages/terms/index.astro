---
import { integ, terms } from '@/site.config'

import PageLayout from '@/layouts/SimplePageLayout.astro'
import { CardList } from '@/components/user'
import { cn } from '@/utils/class-merge'

const meta = {
  title: 'Site Policy',
  description: 'Site policy documentation'
}
---

<PageLayout {meta} title='Site Policy' back='/'>
  <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
    <CardList {...terms} />
  </div>
</PageLayout>
